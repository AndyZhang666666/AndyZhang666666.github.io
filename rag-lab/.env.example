# Copy only within rag-lab/.env.local. Never use credentials from another project.
# node --env-file=.env.local server/server.mjs
PORT=4318
# Generate your own independent >= 24 character random admin credential.
# RAG_ADMIN_TOKEN=
# Optional Responses-compatible endpoint and a model you have access to:
# RAG_MODEL_URL=https://api.openai.com/v1/responses
# RAG_MODEL_NAME=
# RAG_MODEL_API_KEY=
