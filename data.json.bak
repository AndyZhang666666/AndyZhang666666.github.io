  "projects": [
    {
      "name": "LLM 效果评估体系（creative-eval）",
      "nameEn": "LLM Evaluation Framework (creative-eval)",
      "description": "短剧剧本质量的 LLM 打分裁判与可信度验证。五维评分 rubric，与人工标注 ±1 分一致率 93.1%，同输入连跑三次的加权标准差 0.074。",
      "descriptionEn": "LLM-as-judge for short drama script quality. Five-dimension rubric, 93.1% ±1-point agreement with human labels, weighted std 0.074 across 3 runs.",
      "url": "https://andyzhang666666.github.io",
      "github": "https://github.com/AndyZhang666666/creative-eval",
      "metrics": [
        "93.1% 一致率",
        "0.074 标准差",
        "40 条金标集"
      ],
      "metricsEn": [
        "93.1% agreement",
        "0.074 std dev",
        "40 golden samples"
      ],
      "tags": [
        "AI",
        "Eval",
        "产品"
      ],
      "featured": true,
      "subtitle": "让\"剧本好不好\"变成一个可以被反驳的数字",
      "subtitleEn": "Turning \"is this script good\" into a falsifiable number",
      "context": "短剧行业筛剧本靠制片人主观判断，同一个本子两个人能给出完全相反的结论，且无法复现。",
      "contextEn": "Short-drama script screening relies on subjective judgment; two readers often reach opposite conclusions with no reproducibility.",
      "approach": [
        "拆出钩子强度、人物动机、冲突密度、节奏、爽点五个维度，每维写死分档锚点，消除\"感觉不错\"式打分",
        "人工标注 40 条金标集做基线，用 ±1 分一致率检验 LLM 裁判是否可信",
        "同一输入连跑三次算加权标准差，把\"随机性\"本身当成一个要压住的指标"
      ],
      "approachEn": [
        "Decomposed into 5 dimensions with fixed scoring anchors to eliminate vibe-based grading",
        "Hand-labeled a 40-sample golden set as baseline; validated the judge via ±1-point agreement",
        "Ran identical inputs 3x and tracked weighted std — treating variance itself as a target metric"
      ],
      "result": "一致率 93.1%，标准差 0.074。结论是：这套裁判可以replace初筛，但不能replace终审 —— 这个边界写在 README 第一段。",
      "resultEn": "93.1% agreement, 0.074 std. Conclusion: the judge can replace first-pass screening but not final review — stated in the README opening."
    },
    {
      "name": "LLM 效果评估体系（filing-eval）",
      "nameEn": "LLM Evaluation Framework (filing-eval)",
      "description": "公告摘要的事实核查评测。断言级比对，错误检出 11/11、误报 0/4、提示注入 5/5 守住。",
      "descriptionEn": "Fact-checking eval for announcement summaries. Claim-level verification, 11/11 recall, 0/4 false positives, 5/5 prompt injection blocked.",
      "url": "https://andyzhang666666.github.io",
      "github": "https://github.com/AndyZhang666666/filing-eval",
      "metrics": [
        "11/11 检出",
        "0/4 误报",
        "5/5 防注入"
      ],
      "metricsEn": [
        "11/11 recall",
        "0/4 FP",
        "5/5 injection blocked"
      ],
      "tags": [
        "AI",
        "Eval",
        "产品"
      ],
      "subtitle": "摘要是否忠于原文，逐条断言去对",
      "subtitleEn": "Claim-level fact-checking for generated summaries",
      "context": "模型给公告写摘要时会\"顺口\"加上原文没有的数字和因果，人工抽检成本高且抓不全。",
      "contextEn": "Summarization models fabricate numbers and causal links absent from the source; manual spot checks are costly and incomplete.",
      "approach": [
        "把摘要切成原子断言，逐条回原文找证据，判定「支持 / 矛盾 / 无依据」",
        "构造 4 条\"看起来像错但其实对\"的诱导样本，专门测误报",
        "塞 5 条提示注入进原文，检验评测流程本身会不会被带跑"
      ],
      "approachEn": [
