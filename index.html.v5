</footer>

<div class="palette-switch" id="paletteSwitch" role="group" aria-label="配色">
  <span class="ps-label">Theme</span>
  <button type="button" class="ps-btn" data-palette="copper" data-name="铜 · 墨绿" style="--sw-bg:#0a0e0c;--sw-accent:#d8a27a" aria-label="铜 · 墨绿"></button>
  <button type="button" class="ps-btn" data-palette="indigo" data-name="靛 · 石墨" style="--sw-bg:#090a0f;--sw-accent:#8b8cff" aria-label="靛 · 石墨"></button>
  <button type="button" class="ps-btn" data-palette="mist" data-name="雾 · 青灰" style="--sw-bg:#f0f3f7;--sw-accent:#254ed6" aria-label="雾 · 青灰"></button>
  <button type="button" class="ps-btn" data-palette="frost" data-name="霜 · 象牙纸" style="--sw-bg:#f5f2eb;--sw-accent:#d9481c" aria-label="霜 · 象牙纸"></button>
</div>

